{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}},"routeCache":{"key":"/route-cache/APP_PAGE/c6377dd9ce6a1c2cd100eb4344e843eb4639b9ed26f84643f77680e9eb454c4b/$/index","owner":{"kind":"APP_PAGE","sourceRoute":"/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" data-scroll-behavior=\"smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0cz6nq5y6-ovp.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1x6obpmlu1_c2.js\"/><script src=\"/_next/static/chunks/2r4s4h5xul1n-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2khxl0v1q4i6n.js\" async=\"\"></script><script src=\"/_next/static/chunks/2e268anpfvdoc.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3-ry682tkyiqk.js\" async=\"\"></script><script src=\"/_next/static/chunks/43o5ks_yxvo6n.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#111210\"/><meta name=\"color-scheme\" content=\"dark\"/><title>Muhammad Taha Malik — Software &amp; Automation</title><meta name=\"description\" content=\"Muhammad Taha Malik is a backend engineer and Computer Science student building practical software, workflow automations, and AI-powered experiences.\"/><link rel=\"canonical\" href=\"https://maliktaha.me\"/><meta property=\"og:title\" content=\"Muhammad Taha Malik — Software &amp; Automation\"/><meta property=\"og:description\" content=\"Practical software, workflow automations, and AI-powered experiences.\"/><meta property=\"og:url\" content=\"https://maliktaha.me\"/><meta property=\"og:site_name\" content=\"Taha Malik\"/><meta property=\"og:image\" content=\"https://maliktaha.me/social-card.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Taha Malik — Software &amp; Automation\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Muhammad Taha Malik — Software &amp; Automation\"/><meta name=\"twitter:description\" content=\"Practical software, workflow automations, and AI-powered experiences.\"/><meta name=\"twitter:image\" content=\"https://maliktaha.me/social-card.png\"/><link rel=\"shortcut icon\" href=\"/icon.svg\"/><link rel=\"icon\" href=\"/icon.svg\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a class=\"skip-link\" href=\"#main-content\">Skip to content</a><header class=\"site-header\"><div class=\"header-inner\"><a class=\"wordmark\" aria-label=\"Taha Malik home\" href=\"/\">TAHA<span>·</span></a><nav class=\"desktop-nav\" aria-label=\"Main navigation\"><a href=\"/\">Home</a><a href=\"/#projects\">Projects</a><a href=\"/#about\">About</a><a href=\"/writing\">Writing</a><a href=\"/#contact\">Contact</a></nav><a class=\"header-contact\" href=\"mailto:muhammad.taha.dandhla@gmail.com\">Let’s talk <span aria-hidden=\"true\">↗</span></a><button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-navigation\"><span class=\"sr-only\">Open menu</span><span aria-hidden=\"true\">☰</span></button></div><nav id=\"mobile-navigation\" class=\"mobile-nav\" aria-label=\"Mobile navigation\" hidden=\"\"><a href=\"/\">Home<span aria-hidden=\"true\">↗</span></a><a href=\"/#projects\">Projects<span aria-hidden=\"true\">↗</span></a><a href=\"/#about\">About<span aria-hidden=\"true\">↗</span></a><a href=\"/writing\">Writing<span aria-hidden=\"true\">↗</span></a><a href=\"/#contact\">Contact<span aria-hidden=\"true\">↗</span></a></nav></header><main id=\"main-content\"><section class=\"hero page-wrap\"><div class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"status-dot\"></span> COMPUTER SCIENCE / SOFTWARE / AI AUTOMATION</div><h1>Building software,<br/><em>automations,</em> and<br/>AI-powered experiences<span class=\"accent-dot\">.</span></h1><p class=\"hero-intro\">I’m Muhammad Taha Malik, a Computer Science student and developer exploring full-stack engineering, intelligent automation, and AI voice agents. I enjoy turning ideas into practical, working products.</p><div class=\"hero-actions\"><a class=\"button button-primary\" href=\"#projects\">Explore my work <span aria-hidden=\"true\">↘</span></a><a class=\"button button-quiet\" href=\"#contact\">Get in touch <span aria-hidden=\"true\">↗</span></a></div></div><div class=\"hero-art\" aria-label=\"A diagram of software and automation concepts\" role=\"img\"><div class=\"art-coordinate\">SYS / 01.26</div><div class=\"art-orbit orbit-outer\"><i></i><i></i></div><div class=\"art-orbit orbit-inner\"><i></i></div><div class=\"art-core\"><span>TM</span><small>IDEA → SYSTEM</small></div><span class=\"art-label label-code\">{ code }</span><span class=\"art-label label-flow\">↗ workflow</span><span class=\"art-label label-api\">API<span> ● </span>connected</span><div class=\"art-foot\"><span>THOUGHTFUL BY DESIGN</span><span>01 — 07</span></div></div><div class=\"hero-bottom\"><span>ISLAMABAD, PAKISTAN</span><span>SCROLL TO EXPLORE <b>↓</b></span></div></section><section class=\"section section-projects page-wrap\" id=\"projects\"><div class=\"section-heading\"><div><span class=\"section-index\">01 / SELECTED WORK</span><h2>Things I’ve <em>built.</em></h2></div><a class=\"text-link\" href=\"/projects\">All projects <span aria-hidden=\"true\">↗</span></a></div><div class=\"project-grid featured-grid\"><article class=\"project-card project-card-0\"><a class=\"project-visual-link\" aria-label=\"Read about ShopIT\" href=\"/projects/shopit\"><div class=\"project-visual visual-shop \" aria-hidden=\"true\"><div class=\"shop-window\"><span class=\"window-dots\">● ● ●</span><span class=\"shop-search\">Find something useful <i>⌕</i></span><div class=\"shop-product\"><span class=\"product-art\"><b>01</b></span><span><strong>Everyday objects</strong><small>Thoughtfully selected</small></span><b class=\"shop-bag\">↗</b></div><div class=\"shop-line\"></div></div><div class=\"recovery-tag\"><span>↗</span><strong>Cart recovery</strong><small>workflow active</small></div></div></a><div class=\"project-card-meta\"><span>Commerce · automation</span><span>Project</span></div><h3><a href=\"/projects/shopit\">ShopIT<span aria-hidden=\"true\">↗</span></a></h3><p>A MERN e-commerce application connected to an abandoned-cart recovery workflow with reminders and recovery tracking.</p><div class=\"tech-list\" aria-label=\"Technologies\"><span>MongoDB</span><span>Express.js</span><span>React</span><span>Node.js</span><span>n8n</span></div></article><article class=\"project-card project-card-1\"><a class=\"project-visual-link\" aria-label=\"Read about AI-Powered Facebook Ad Generator\" href=\"/projects/facebook-ad-generator\"><div class=\"project-visual visual-workflow \" aria-hidden=\"true\"><div class=\"flow-canvas\"><div class=\"flow-node node-trigger\"><span>01</span><strong>Product brief</strong><small>structured input</small></div><i class=\"flow-link link-one\"></i><div class=\"flow-node node-ai\"><span>✳</span><strong>Generate</strong><small>OpenAI</small></div><i class=\"flow-link link-two\"></i><div class=\"flow-node node-done\"><span>✓</span><strong>Review</strong><small>approval queue</small></div><div class=\"flow-caption\">n8n · workflow</div></div></div></a><div class=\"project-card-meta\"><span>Creative operations</span><span>Workflow</span></div><h3><a href=\"/projects/facebook-ad-generator\">AI-Powered Facebook Ad Generator<span aria-hidden=\"true\">↗</span></a></h3><p>An automation workflow that turns product information into marketing copy and creative options, with structured storage and an approval step.</p><div class=\"tech-list\" aria-label=\"Technologies\"><span>n8n</span><span>OpenAI</span><span>Airtable</span><span>Supabase</span></div></article><article class=\"project-card project-card-2\"><a class=\"project-visual-link\" aria-label=\"Read about AI Voice Appointment Booking Agent\" href=\"/projects/voice-appointment-agent\"><div class=\"project-visual visual-voice \" aria-hidden=\"true\"><div class=\"voice-screen\"><div class=\"voice-top\"><span>VOICE / 01</span><span class=\"voice-live\"><i></i> LIVE FLOW</span></div><div class=\"waveform\"><i style=\"--bar:18%\"></i><i style=\"--bar:55.36462585978608%\"></i><i style=\"--bar:75.15608433933069%\"></i><i style=\"--bar:68.06614326563468%\"></i><i style=\"--bar:37.42931270904249%\"></i><i style=\"--bar:38.34542720599795%\"></i><i style=\"--bar:68.55139479998809%\"></i><i style=\"--bar:74.9822515322113%\"></i><i style=\"--bar:54.61346499659465%\"></i><i style=\"--bar:18.975206228092283%\"></i><i style=\"--bar:56.105222725689764%\"></i><i style=\"--bar:75.31375756486602%\"></i><i style=\"--bar:67.56673666912033%\"></i><i style=\"--bar:36.50770501626242%\"></i><i style=\"--bar:39.255789496611754%\"></i><i style=\"--bar:69.02235407835687%\"></i><i style=\"--bar:74.79230829077642%\"></i><i style=\"--bar:53.85195250974802%\"></i><i style=\"--bar:19.95013673882593%\"></i><i style=\"--bar:56.83504620740286%\"></i><i style=\"--bar:75.45522663030249%\"></i><i style=\"--bar:67.05331620629019%\"></i><i style=\"--bar:35.58086469125083%\"></i><i style=\"--bar:40.16014219667234%\"></i><i style=\"--bar:69.47888794772717%\"></i><i style=\"--bar:74.58630831715314%\"></i><i style=\"--bar:53.08030369956448%\"></i><i style=\"--bar:20.92451589279505%\"></i><i style=\"--bar:57.55388996395171%\"></i><i style=\"--bar:75.58045153848259%\"></i><i style=\"--bar:66.52602703509126%\"></i><i style=\"--bar:34.64905377700825%\"></i><i style=\"--bar:41.05822962104311%\"></i><i style=\"--bar:69.92086733354145%\"></i></div><div class=\"voice-transcript\"><span>AGENT</span><strong>How can I help you today?</strong></div><div class=\"voice-bottom\"><span>Retell AI / Vapi</span><span>n8n ↗ database</span></div></div></div></a><div class=\"project-card-meta\"><span>Conversational systems</span><span>Project</span></div><h3><a href=\"/projects/voice-appointment-agent\">AI Voice Appointment Booking Agent<span aria-hidden=\"true\">↗</span></a></h3><p>A voice-agent project designed to handle appointment booking and related requests through conversation and workflow integrations.</p><div class=\"tech-list\" aria-label=\"Technologies\"><span>Retell AI or Vapi</span><span>n8n</span><span>Webhooks</span><span>Database integrations</span></div></article></div></section><section class=\"section about-section\" id=\"about\"><div class=\"page-wrap about-layout\"><div class=\"about-heading\"><span class=\"section-index\">02 / A LITTLE ABOUT ME</span><h2>Curious by nature.<br/><em>Practical by choice.</em></h2><p class=\"about-note\">A backend engineer learning in public and building with intent.</p></div><div class=\"about-body\"><p>I’m a Computer Science student drawn to the systems behind useful products: the APIs, data models, and automations that make an idea dependable in everyday use.</p><p>My work spans MERN applications, Python services, and AI-enabled workflows. I’m especially interested in how voice agents and automation can make routine interactions feel simpler.</p><div class=\"experience-block\"><span class=\"section-index\">CURRENTLY</span><div><strong>AI Automation Engineer<!-- --> <span>at</span> <!-- -->TrillesAI</strong><small>Islamabad<!-- --> · <!-- -->January 2026 – Present</small></div><a aria-label=\"Read about TrillesAI website project\" href=\"/projects/trillesai-website\">↗</a></div><div class=\"education-block\"><span class=\"section-index\">EDUCATION</span><div><strong>Bachelor of Science in Computer Science</strong><small>NUST, Pakistan<!-- --> · <!-- -->September 2024 – May 2028</small></div></div><a class=\"text-link about-link\" href=\"/projects\">Explore my projects ↗</a></div></div></section><section class=\"section skills-section page-wrap\"><div class=\"section-heading\"><div><span class=\"section-index\">03 / TOOLS OF THE TRADE</span><h2>What I work <em>with.</em></h2></div><p>Technologies are tools. The interesting part is what they help us make.</p></div><div class=\"skills-list\"><div class=\"skill-row\"><span class=\"skill-number\">0<!-- -->1</span><h3>Frontend</h3><div><span>HTML</span><span>CSS</span><span>JavaScript</span><span>TypeScript</span><span>React</span><span>Next.js</span><span>Flutter</span></div></div><div class=\"skill-row\"><span class=\"skill-number\">0<!-- -->2</span><h3>Backend</h3><div><span>Node.js</span><span>Express.js</span><span>Python</span><span>FastAPI</span><span>REST APIs</span></div></div><div class=\"skill-row\"><span class=\"skill-number\">0<!-- -->3</span><h3>AI &amp; automation</h3><div><span>n8n</span><span>Make.com</span><span>AI workflow integration</span><span>Vapi</span><span>Retell AI</span><span>LLM APIs</span></div></div><div class=\"skill-row\"><span class=\"skill-number\">0<!-- -->4</span><h3>Data</h3><div><span>MongoDB</span><span>PostgreSQL</span><span>MySQL</span><span>SQLite</span></div></div><div class=\"skill-row\"><span class=\"skill-number\">0<!-- -->5</span><h3>Infrastructure</h3><div><span>Git</span><span>GitHub</span><span>Docker</span><span>Google Cloud Platform</span><span>Kubernetes</span><span>Cloud platforms</span></div></div></div></section><section class=\"section contact-section\" id=\"contact\"><div class=\"page-wrap contact-layout\"><div><span class=\"section-index\">04 / HAVE A GOOD ONE IN MIND?</span><h2>Let’s make<br/><em>something useful.</em></h2></div><div class=\"contact-copy\"><p>Have a project, an interesting problem, or an idea you’d like to explore? I’d be glad to hear about it.</p><a class=\"button button-primary\" href=\"mailto:muhammad.taha.dandhla@gmail.com\">Start a conversation <span aria-hidden=\"true\">↗</span></a><div class=\"contact-details\"><a href=\"mailto:muhammad.taha.dandhla@gmail.com\">muhammad.taha.dandhla@gmail.com</a><a href=\"https://github.com/MuhammadTahaD\" target=\"_blank\" rel=\"noreferrer\">GitHub ↗</a><a href=\"https://linkedin.com/in/Muhammad-taha-615670332\" target=\"_blank\" rel=\"noreferrer\">LinkedIn ↗</a><span>Islamabad, Pakistan</span></div></div></div></section><!--$--><!--/$--></main><footer class=\"site-footer\"><div class=\"footer-main\"><a class=\"wordmark\" href=\"/\">TAHA<span>·</span></a><p>Thoughtful software, built one useful thing at a time.</p><div class=\"footer-links\"><a href=\"/#projects\">Projects</a><a href=\"/#about\">About</a><a href=\"/writing\">Writing</a><a href=\"/#contact\">Contact</a></div></div><div class=\"footer-bottom\"><span>© <!-- -->2026<!-- --> Muhammad Taha Malik</span><span>Designed and built with care.</span><div><a href=\"https://github.com/MuhammadTahaD\" target=\"_blank\" rel=\"noreferrer\">GitHub ↗</a><a href=\"https://linkedin.com/in/Muhammad-taha-615670332\" target=\"_blank\" rel=\"noreferrer\">LinkedIn ↗</a></div></div></footer><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/1x6obpmlu1_c2.js\",\"static/chunks/2r4s4h5xul1n-.js\",\"static/chunks/2khxl0v1q4i6n.js\",\"static/chunks/2e268anpfvdoc.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/1x6obpmlu1_c2.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:\\\"/_next/static/chunks/43o5ks_yxvo6n.js\\\"\\n3:I[55068,[\\\"$2\\\"],\\\"SiteNav\\\"]\\n4:I[39756,[\\\"$2\\\"],\\\"default\\\"]\\n5:I[37457,[\\\"$2\\\"],\\\"default\\\"]\\n6:I[22016,[\\\"$2\\\"],\\\"\\\"]\\nf:\\\"ViewportBoundary\\\"\\n10:I[97367,[\\\"$2\\\"],\\